# Copy to .env.local for development. Nothing here is required to run `npm run dev` today —
# the commerce engine still runs on mock data until Supabase/Stripe are actually wired up
# (see docs/commerce/SUPABASE_SCHEMA_PROPOSAL.md and STRIPE_OBJECT_MAPPING.md).

# development | preview | production — explicit override; see src/commerce/env.ts.
# Leave unset locally; Next sets NODE_ENV for you.
# HUB_ENV=development

# The real production domain, once registered. Used for sitemap.xml, robots.txt, and absolute
# Open Graph URLs (src/app/site-config.ts). Falls back to a placeholder if unset.
# NEXT_PUBLIC_SITE_URL=https://thehub-lloydswharf.example

# Where the /contact form's mailto: is addressed. Falls back to a placeholder if unset.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@thehub-lloydswharf.example

# --- Not yet wired into any code. Added here so their names are decided once, not guessed at
#     integration time. Fill in when Supabase/Stripe are actually approved and created. ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
