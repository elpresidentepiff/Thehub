{
  "name": "the-hub-lloyds-wharf",
  "version": "0.2.0",
  "private": true,
  "description": "The Hub at Lloyds Wharf — digital experience",
  "scripts": {
    "sync-media": "node scripts/sync-media.mjs",
    "predev": "node scripts/sync-media.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-media.mjs && node scripts/check-boundaries.mjs",
    "build": "next build",
    "postbuild": "node scripts/check-bundle.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-boundaries.mjs && tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\"",
    "measure": "node scripts/measure.mjs",
    "db:test": "node scripts/db-test.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@liquefy-ui/react": "^1.0.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.0",
    "@theatre/core": "^0.7.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0",
    "web-vitals": "^6.2.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@theatre/studio": "^0.7.2",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9"
  }
}
